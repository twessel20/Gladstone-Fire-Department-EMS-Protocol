T*
(* Dibenzepin \(Noveril, Victoril\)) Tj
T*
(* Dimetacrine \(Istonil, Istonyl, Miroistonil\)) Tj
T*
(* Dosulepin/Dothiepin \(Prothiaden\)) Tj
T*
(* Doxepin \(Adapin, Sinequan\)) Tj
T*
(* Imipramine \(Tofranil, Janimine, Praminil\)) Tj
T*
(* Imipraminoxide \(Imiprex, Elepsin\)) Tj
T*
(* Lofepramine \(Lomont, Gamanil\)) Tj
T*
(* Melitracen \(Deanxit, Dixeran, Melixeran, Trausabun\)) Tj
T*
(* Metapramine \(Timaxel\)) Tj
T*
(* Nitroxazepine \(Sintamil\)) Tj
T*
(* Nortriptyline \(Pamelor, Aventyl, Norpress\)) Tj
T*
